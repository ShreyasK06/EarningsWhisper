# Baked into the GitHub Pages build (Vite loads .env.production automatically
# for `npm run build`). These are Firebase's public web app config, not
# secrets — see .env.example and firestore.rules for why this is safe to
# ship in the browser bundle. VITE_API_BASE is intentionally left unset here:
# GitHub Pages only hosts this static frontend, not the FastAPI backend, so
# it falls back to http://localhost:8000 — the deployed page's chat features
# work once a visitor runs the backend locally (see README).
VITE_FIREBASE_API_KEY=AIzaSyDVPR-qMAp2U-8lskLT_RrCYxUn5UyfJgs
VITE_FIREBASE_AUTH_DOMAIN=eanringwhisper.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eanringwhisper
VITE_FIREBASE_STORAGE_BUCKET=eanringwhisper.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=275513228689
VITE_FIREBASE_APP_ID=1:275513228689:web:733e0625725dab65d96e30

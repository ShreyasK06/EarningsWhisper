VITE_API_BASE=http://localhost:8000

# Firebase (chat persistence + Google sign-in) — optional. Leave unset and
# the app works exactly as it does without them (no login, no persistence).
# These are Firebase's public web app config, not secrets — get them from
# Firebase Console > Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

ANTHROPIC_API_KEY=sk-ant-...
QDRANT_PATH=./qdrant_data
EMBED_MODEL=BAAI/bge-small-en-v1.5

# SEC EDGAR requires a descriptive User-Agent identifying the requester.
SEC_EDGAR_COMPANY_NAME=Your Name
SEC_EDGAR_EMAIL=your-email@example.com

# Optional: only set these if pointing at a real Qdrant server instead of
# local on-disk mode (e.g. once Docker is available).
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
